    "text_slice",
    "int_float",
    "float_int",
    "float_text"
  ],
  "arithmetic": [
    "+",
    "-",
    "/",
    "*",
    "%",
    "div",
    "^"
  ],
  "boolean_relational": [
    "&&",
    "||",
    "!",
    ">",
    "<",
    "==",
    "!=",
    ">=",
    "<="
  ],
  "extension": ".tfd",
  "identifier": "[A-Za-z_][A-Za-z0-9_]* except standalone _",
  "literal_families": [
    "INT_LITERAL",
    "FLOAT_LITERAL",
    "BOOL_LITERAL",
    "TEXT_LITERAL",
    "CHAR_LITERAL"
  ],
  "source_encoding": "UTF-8 without BOM; LF or CRLF, no lone CR",
  "numeric_bounds": "Lexer retains decimal lexemes without host bounds. Int64 and finite binary64 validation belongs to the compiler semantic phase, excluded from Stage 1."
}
