// Ternfold lexical demonstration: every required category.
/* Block comments are included in the table.
   They stop at the first closing delimiter. */
record Point { x: Int, y: Float }
enum Direction { Left, Right }
machine Counter(delta: Int) yields Int rejects Text {
    state count: Int = 0;
    next count = count + delta;
    guard next.count >= 0 else "negative";
    emit next.count;
}
fn square(x: Int) -> Int { x ^ 2 }
fn polynomial(x: Int) -> Int { (x + 1) * 2 - 1 }
pub fn main() -> List[Text] {
    input visitor: Text from stdin;
    let integer: Int = 17;
    let real: Float = 1.25e1;
    let flag: Bool = true;
    let text: Text = "Hello\nTernfold";
    let mark: Char = 'Ω';
    let divide = 7 / 2;
    let quotient = -7 div 3;
    let remainder = 7 % 3;
    let power = 2 ^ 3;
    let comparisons = (3 > 2) && (2 < 3) && (2 == 2) && (2 != 3)
                      && (3 >= 3) && (2 <= 2) && (!false || true);
    let values = for item in range(0, 2) { item * 2 };
    let length: Int = len(values);
    let idle: Unit = ();
    let transition: Decision[Counter, Int, Text] = step(Counter(), 3);
    let choice = match Option::Some(flag) {
        Option::Some(value) => { value }, Option::None => { false }
    };
    output text ++ visitor to stdout;
    [float_text(divide), int_text(quotient)]
}
