import "support.tfd" as helper;
// Ternfold lexical demonstration: every current keyword and reserved name.
/* Block comments are included in the table.
   They stop at the first closing delimiter. */
record Point { x: Int, y: Float }
enum Direction { Left, Right }
machine Counter(delta: Int) yields Int rejects Text {
    state count: Int = 0;
    next count = count + delta;
    guard next.count >= 0 else "negative";
    emit next.count;
}
fn square(x: Int) -> Int { x ^ 2 }
fn polynomial(x: Int) -> Int { (x + 1) * 2 - 1 }
pub fn main() -> List[Text] {
    input visitor: Text from stdin;
    let integer: Int = 17;
    let real: Float = 1.25e1;
    let flag: Bool = true;
    let text: Text = "Hello\nTernfold";
    let mark: Char = 'Ω';
    let divide = 7 / 2;
    let quotient = -7 div 3;
    let remainder = 7 % 3;
    let power = square(2);
    let comparisons = (3 > 2) && (2 < 3) && (2 == 2) && (2 != 3)
                      && (3 >= 3) && (2 <= 2) && (!false || true);
    let values = for item in range(0, 2) { item * 2 };
    let length: Int = len(values);
    let idle: Unit = ();
    let transition: Decision[Counter, Int, Text] = step(Counter(), 3);
    let decision_text: Text = match transition {
        Decision::Accept(updated, messages) => { int_text(len(messages)) },
        Decision::Reject(old, error) => { error }
    };
    let choice: Option[Bool] = Option::Some(flag);
    let chosen = match choice {
        Option::Some(value) => { value }, Option::None => { false }
    };
    let first: Option[Int] = at(values, 0);
    let extended: List[Int] = append(values, integer);
    let squares: List[Int] = map(extended, square);
    let total: Int = fold(squares, 0, fn(sum: Int, item: Int) -> Int { sum + item });
    let parsed: Option[Int] = parse_int("17");
    let visitor_length: Int = text_len(visitor);
    let initial: Option[Text] = text_at(visitor, 0);
    let greeting: Option[Text] = text_slice(text, 0, 5);
    let greeting_text: Text = match greeting { Option::Some(value) => { value }, Option::None => { "Hello" } };
    let converted: Float = int_float(total);
    let rounded: Option[Int] = float_int(real);
    let label: Text = if chosen { bool_text(comparisons) } else { "false" };
    let _ = helper::identity(length);
    output text ++ visitor to stdout;
    [greeting_text, decision_text, label, float_text(divide), int_text(quotient)]
}
