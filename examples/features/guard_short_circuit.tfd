machine AlwaysReject(request: Int) yields Int rejects Text {
    state value: Int = 0;
    next value = request;
    guard false else "first reason";
    guard 1 div 0 == 0 else "unreachable reason";
    emit 1 div 0;
}
pub fn main() -> List[Text] {
    match step(AlwaysReject(), 8) {
        Decision::Accept(snapshot, values) => { ["unexpected"] },
        Decision::Reject(snapshot, reason) => { [reason, int_text(snapshot.value)] }
    }
}
