machine Pair(request: Unit) yields Int rejects Text {
    state left: Int = 2;
    state right: Int = 9;
    next left = right;
    next right = left;
    emit next.left;
    emit next.right;
}
pub fn main() -> List[Text] {
    match step(Pair(), ()) {
        Decision::Accept(pair, values) => { map(values, int_text) },
        Decision::Reject(pair, reason) => { [reason] }
    }
}
