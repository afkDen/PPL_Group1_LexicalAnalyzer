import "models/shelf.tfd" as shelf;

fn state_of(result: Decision[shelf::Shelf, Text, shelf::Fault]) -> shelf::Shelf {
    match result {
        Decision::Accept(snapshot, messages) => { snapshot },
        Decision::Reject(snapshot, reason) => { snapshot }
    }
}

fn report(result: Decision[shelf::Shelf, Text, shelf::Fault]) -> List[Text] {
    match result {
        Decision::Accept(snapshot, messages) => { messages },
        Decision::Reject(snapshot, reason) => {
            let label = match reason {
                shelf::Fault::Underflow => { "underflow" },
                shelf::Fault::Capacity => { "capacity" }
            };
            ["rejected " ++ label ++ "; count=" ++ int_text(snapshot.count)]
        }
    }
}

pub fn main() -> List[Text] {
    let original = shelf::Shelf();
    let accepted = step(original, shelf::Change(delta: 4));
    let after = state_of(accepted);
    let rejected = step(after, shelf::Change(delta: 9));
    let independent = step(original, shelf::Change(delta: 1));
    ["Ternfold: inspect a change before accepting it"]
        ++ report(accepted)
        ++ report(rejected)
        ++ ["original still=" ++ int_text(original.count)]
        ++ report(independent)
}
