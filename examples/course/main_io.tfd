// Revision 2 showcase: intentionally pending implementation until M09/M11.
/* Two input/output clauses are deterministic, staged only after successful evaluation. */
fn square(x: Int) -> Int { x ^ 2 }
fn polynomial(x: Int) -> Int { 2 * (x ^ 2) + 3 * x - 1 }
fn grid() -> List[List[Int]] {
    for row in range(0, 2) {
        for col in range(0, 3) { row * 10 + col }
    }
}
pub fn main() -> List[Text] {
    input visitor: Text from stdin;
    let score = polynomial(3);
    let rounded = -7 div 3;
    let letter: Char = 'T';
    output "Hello " ++ visitor to stdout;
    [int_text(score), int_text(rounded)]
}
