/* Bounded block comment. */
// A line comment.
fn square(x: Int) -> Int { x ^ 2 }
fn matrix() -> List[List[Int]] {
    for row in range(0, 2) {
        for col in range(0, 3) { row * 10 + col }
    }
}
pub fn main() -> List[Text] {
    let message: Text = "Ternfold";
    let initial: Char = 'T';
    [message, int_text(-7 div 3)]
}
