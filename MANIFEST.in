include README.md AGENTS.md pyproject.toml uv.lock .python-version .editorconfig .gitignore
recursive-include docs *.md *.json *.txt
recursive-include examples *.tfd *.json *.md
recursive-include experiments *.py
recursive-include scripts *.py
recursive-include .agents/skills *.md
recursive-include runtime *.md
recursive-include stdlib *.md
recursive-include src *.md py.typed
recursive-include tests *.py *.md *.json *.txt *.tfd
prune .venv
prune .uv-cache
prune build
prune dist
global-exclude __pycache__ *.py[cod]
